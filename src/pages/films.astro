---
import CatalogShell from "../components/film/CatalogShell.astro";
import FilmGrid from "../components/film/FilmGrid.astro";
import { films } from "../data/films";
import { ajVaultCard } from "../data/ajvault";

const filmItems = films.map((film) => ({
  href: `/films/${film.slug}`,
  title: film.title,
  thumbnail: film.thumbnail,
  meta: [film.year, film.genre].filter(Boolean).join(" \u00b7 "),
  ariaLabel: `See more about ${film.title} (${film.year})`,
}));
---

<CatalogShell
  title="Films — Ayden Salazar"
  description="Short films written, directed, and produced by Ayden Salazar."
  eyebrow="Portfolio"
  heading="Films"
  backHref="/"
  backLabel="Home"
>
  <FilmGrid id="section-short-films" heading="Short Films" items={filmItems} />

  <FilmGrid
    id="section-aj-vault"
    heading={ajVaultCard.title}
    items={[
      {
        href: ajVaultCard.href,
        title: ajVaultCard.title,
        thumbnail: ajVaultCard.thumbnail,
        meta: ajVaultCard.meta,
        ariaLabel: `Open ${ajVaultCard.title}, a directory of childhood films`,
      },
    ]}
  />
</CatalogShell>
