---
import FilmDetail from "../../components/film/FilmDetail.astro";
import { films, type Film } from "../../data/films";

export function getStaticPaths() {
  return films.map((film) => ({
    params: { slug: film.slug },
    props: { film },
  }));
}

interface Props {
  film: Film;
}

const { film } = Astro.props;
---

<FilmDetail
  film={film}
  siblings={films}
  basePath="/films"
  backHref="/films"
  backLabel="← Films"
/>
